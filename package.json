{
  "name": "ipcam-control",
  "version": "0.2.0",
  "description": "Provides access to ipcam onvif services, PTZ and livestream through rtsp",
  "author": {
    "name": "Andy Attwell"
  },
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:build": "vue-cli-service electron:build",
    "electron:serve": "vue-cli-service electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "cam:serve": "node src/server/server.js",
    "cam:watch": "nodemon src/server/server.js",
    "sass:watch": "sass --watch src/server/public/css/styles.scss:src/server/public/css/styles.css"
  },
  "main": "background.js",
  "dependencies": {
    "@popperjs/core": "^2.11.5",
    "autoprefixer": "10.4.5",
    "axios": "^1.3.3",
    "bootstrap": "^5.1.3",
    "bootstrap-icons": "^1.8.2",
    "core-js": "^3.8.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "jquery": "^3.6.0",
    "local-devices": "^4.0.0",
    "node-sass": "^7.0.3",
    "node-windows": "^1.0.0-beta.8",
    "nodemon": "^2.0.22",
    "onvif": "^0.6.7",
    "request": "^2.88.2",
    "rtsp-relay": "^1.8.0",
    "sqlite3": "^5.0.6",
    "vue": "^3.3.4",
    "vue-router": "^4.1.6",
    "vuex": "^4.0.2",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.22.4",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "babel-loader": "^9.1.2",
    "electron": "^13.0.0",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "vue-cli-plugin-electron-builder": "~2.1.1",
    "webpack": "^5.72.0",
    "webpack-node-externals": "^3.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "excludeFromBundle": {}
}
